# 管理员账号（单账号）
# 修改密码：改这里后删除 data/wufamily.db 重启，或直接改库中的 password_hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成一个强密码

# 会话签名密钥：必须是一个随机长字符串，泄露等于登录态可被伪造
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=请填入随机字符串

# 会话 Cookie 是否仅通过 HTTPS 发送。
# 默认跟随 NODE_ENV（生产 true、开发 false）。
#
# 若以 http://局域网IP:3000 这种方式访问（没有 HTTPS），
# 必须设为 false，否则浏览器会拒绝保存 Cookie，
# 表现为「登录后仍不断跳回登录页」。
# 一旦配置了 HTTPS，请改回 true 或删除本行。
COOKIE_SECURE=false
