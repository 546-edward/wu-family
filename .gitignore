# 依赖
/node_modules
/.pnp
.pnp.js

# 构建产物
/.next/
/out/
/dist/
/build

# Next.js 自动生成（内容随 dev/build 切换而变，不应入库）
/next-env.d.ts

# 生产环境
/.vercel
*.tsbuildinfo

# 环境变量（含密钥，禁止入库）
.env
.env*.local
.env.production

# 运行时数据（SQLite 数据库与上传的 Excel 原件，禁止入库）
/data/

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器与系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 临时文件
*.swp
*.swo
/tmp/
